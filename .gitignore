# Generated by scripts/data/*. The inputs (schools.json, the emitters) are
# tracked; the SQL they produce is not, so a stale checked-in dump can never be
# mistaken for the source of truth.
seed.sql
rounds.sql
cycles.sql

# Scratch file for multi-line commit messages. PowerShell mangles multi-line
# -m arguments, so `git commit -F .commitmsg` is used instead; the file is
# transient and must never be committed.
.commitmsg
