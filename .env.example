# ---------------------------------------------------------------------------
# MBAround environment variables
# Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Frontend (safe to expose to the browser; protected by Supabase RLS) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SITE_URL=http://localhost:5173

# --- Server-side only. Used by scripts/ for seeding & future cron workers. ---
# Bypasses RLS. Never expose to the browser, never commit.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
